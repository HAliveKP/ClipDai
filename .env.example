# ======================= ClipForge settings =======================
# Copy this file to .env and fill in only what you need.
# With NOTHING filled in, ClipForge still works: local Whisper + a built-in
# heuristic highlight finder + "manual" publishing (ready-to-post folder).

# ---------- 1) Highlight-finding AI (pick ONE, all have a free option) ----------
# Google AI Studio free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fully local & free (no key): install Ollama, `ollama pull llama3.1:8b`, then:
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
# Any OpenAI-compatible endpoint (OpenRouter free models, LM Studio, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=
# Force a provider: gemini | groq | ollama | openai | none   (blank = auto)
LLM_PROVIDER=

# ---------- 2) Clipping behaviour ----------
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3  (bigger = slower, better)
WHISPER_DEVICE=auto          # auto | cpu | cuda
CLIPS_PER_VIDEO=5
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=60
MAX_SOURCE_HEIGHT=1080
LAYOUT=blur                  # blur (full video on blurred bg) | crop (center-crop) | face (crop centred on the speaker; needs opencv-python-headless)
CROP_X=0.5                   # 0=left .. 1=right, only used by LAYOUT=crop
CAPTION_FONT=Arial
CAPTION_SIZE=78
CREDIT=true                  # add "Clipped from <streamer> <source url>" to descriptions

# ---------- 3) Automation / schedule ----------
AUTO_APPROVE=false           # true = fully hands-off, clips go straight to the posting queue
POST_TIMES=10:00,14:00,19:00 # your LOCAL time, daily slots
MAX_POSTS_PER_DAY=3
SCHEDULE_MODE=local          # local = ClipForge posts at slot time (daemon must run)
                             # provider = hand the schedule time to Upload-Post/Postiz/YouTube
PLATFORMS=youtube,tiktok,instagram
CHECK_INTERVAL_MINUTES=30    # how often watched channels are checked for new VODs
WATCH_BACKFILL=1             # when you add a channel, clip only its newest N VODs (older ones are skipped)
WEB_HOST=127.0.0.1
WEB_PORT=8787

# ---------- 4) Publishing: choose a publisher per platform ----------
# manual     = saves clip + caption in data/ready/ (always free, you tap upload)
# uploadpost = https://upload-post.com API  (free plan: NO TikTok)
# postiz     = Postiz (self-hosted free, or cloud) API
# youtube    = direct YouTube Data API (free; private-only until Google audits your project)
PUBLISHER=                   # default for all platforms (blank = auto: uploadpost/postiz/manual)
PUBLISH_YOUTUBE=
PUBLISH_TIKTOK=
PUBLISH_INSTAGRAM=

UPLOADPOST_API_KEY=
UPLOADPOST_USER=             # the profile name you created in Upload-Post

POSTIZ_API_KEY=
POSTIZ_URL=https://api.postiz.com/public/v1
# self-hosted example: http://localhost:5000/api/public/v1

YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_PRIVACY=public       # public | unlisted | private. (Direct 'youtube' publisher: Google forces private until your API project is audited)
YOUTUBE_CATEGORY=24
TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE
